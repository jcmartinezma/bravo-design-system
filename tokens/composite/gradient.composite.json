{
  "$schema": "../../schemas/dtcg-format.schema.json",
  "gradient": {
    "$description": "Composite color gradients (DTCG stops: color + position 0–1). CSS maps to linear-gradient (top → bottom). Tertiary no longer fades to transparent — core has no transparent token; ends on gray.50.",
    "$type": "gradient",
    "primary": {
      "$description": "gradient-primary — brand accent wash (hero, banners)",
      "$value": [
        {
          "color": "{color.blue.100}",
          "position": 0
        },
        {
          "color": "{color.blue.500}",
          "position": 1
        }
      ]
    },
    "secondary": {
      "$description": "gradient-secondary — soft neutral wash (page backgrounds)",
      "$value": [
        {
          "color": "{color.gray.100}",
          "position": 0
        },
        {
          "color": "{color.gray.300}",
          "position": 1
        }
      ]
    },
    "tertiary": {
      "$description": "gradient-tertiary — soft fade (was transparent; now gray.50 until a transparent core exists)",
      "$value": [
        {
          "color": "{color.gray.200}",
          "position": 0
        },
        {
          "color": "{color.gray.50}",
          "position": 1
        }
      ]
    }
  }
}
