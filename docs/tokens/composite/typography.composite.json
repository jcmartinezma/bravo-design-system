{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "text": {
    "$description": "Composite typography styles (family + size + weight + leading). Starter examples only.",
    "heading": {
      "1": {
        "$type": "typography",
        "$description": "Page titles (h1)",
        "$value": {
          "fontFamily": "{text.style.display}",
          "fontSize": "{text.size.3xl}",
          "fontWeight": "{text.weight.extrabold}",
          "lineHeight": "{text.leading.4xl}",
          "letterSpacing": "{text.letterSpacing.md}"
        }
      },
      "2": {
        "$type": "typography",
        "$description": "Section titles (h2)",
        "$value": {
          "fontFamily": "{text.style.base}",
          "fontSize": "{text.size.xl}",
          "fontWeight": "{text.weight.bold}",
          "lineHeight": "{text.leading.xl}",
          "letterSpacing": "{text.letterSpacing.md}"
        }
      },
      "3": {
        "$type": "typography",
        "$description": "Subsection titles (h3)",
        "$value": {
          "fontFamily": "{text.style.base}",
          "fontSize": "{text.size.lg}",
          "fontWeight": "{text.weight.bold}",
          "lineHeight": "{text.leading.lg}",
          "letterSpacing": "{text.letterSpacing.md}"
        }
      },
      "4": {
        "$type": "typography",
        "$description": "Minor headings (h4)",
        "$value": {
          "fontFamily": "{text.style.base}",
          "fontSize": "{text.size.md}",
          "fontWeight": "{text.weight.bold}",
          "lineHeight": "{text.leading.md}",
          "letterSpacing": "{text.letterSpacing.sm}"
        }
      },
      "5": {
        "$type": "typography",
        "$description": "Small headings (h5)",
        "$value": {
          "fontFamily": "{text.style.base}",
          "fontSize": "{text.size.sm}",
          "fontWeight": "{text.weight.bold}",
          "lineHeight": "{text.leading.sm}",
          "letterSpacing": "{text.letterSpacing.sm}"
        }
      },
      "6": {
        "$type": "typography",
        "$description": "Smallest headings (h6)",
        "$value": {
          "fontFamily": "{text.style.base}",
          "fontSize": "{text.size.xs}",
          "fontWeight": "{text.weight.bold}",
          "lineHeight": "{text.leading.sm}",
          "letterSpacing": "{text.letterSpacing.md}"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$description": "Paragraphs and descriptions",
      "$value": {
        "fontFamily": "{text.style.base}",
        "fontSize": "{text.size.md}",
        "fontWeight": "{text.weight.normal}",
        "lineHeight": "{text.leading.lg}",
        "letterSpacing": "{text.letterSpacing.sm}"
      }
    },
    "label": {
      "$type": "typography",
      "$description": "Form labels, buttons, navigation",
      "$value": {
        "fontFamily": "{text.style.base}",
        "fontSize": "{text.size.xs}",
        "fontWeight": "{text.weight.normal}",
        "lineHeight": "{text.leading.sm}",
        "letterSpacing": "{text.letterSpacing.sm}"
      }
    },
    "caption": {
      "$type": "typography",
      "$description": "Captions, small text, etc.",
      "$value": {
        "fontFamily": "{text.style.base}",
        "fontSize": "{text.size.xs}",
        "fontWeight": "{text.weight.medium}",
        "lineHeight": "{text.leading.sm}",
        "letterSpacing": "{text.letterSpacing.sm}"
      }
    },
    "code": {
      "$type": "typography",
      "$description": "Inline code and monospace snippets",
      "$value": {
        "fontFamily": "{text.style.mono}",
        "fontSize": "{text.size.sm}",
        "fontWeight": "{text.weight.normal}",
        "lineHeight": "{text.leading.md}",
        "letterSpacing": "{text.letterSpacing.sm}"
      }
    }
  }
}
