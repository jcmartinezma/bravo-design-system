{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "motion": {
    "$description": "Composite motion transitions (duration + delay + easing). Starter examples only.",
    "transition": {
      "$type": "transition",
      "fast": {
        "$description": "motion-transition-fast — micro-interactions and hover",
        "$value": {
          "duration": "{motion.speed.fast}",
          "delay": "{motion.delay.none}",
          "timingFunction": "{motion.easing.in-out}"
        }
      },
      "normal": {
        "$description": "motion-transition-normal — standard UI transitions",
        "$value": {
          "duration": "{motion.speed.normal}",
          "delay": "{motion.delay.none}",
          "timingFunction": "{motion.easing.in-out}"
        }
      },
      "slow": {
        "$description": "motion-transition-slow — larger moves (panels, emphasis)",
        "$value": {
          "duration": "{motion.speed.slow}",
          "delay": "{motion.delay.none}",
          "timingFunction": "{motion.easing.in-out}"
        }
      }
    }
  }
}
