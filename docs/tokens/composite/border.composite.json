{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "border": {
    "$description": "Composite borders (width + style + color). Starter examples only.",
    "$type": "border",
    "default": {
      "$description": "border-default — default dividers and outlines",
      "$value": {
        "color": "{color.border.primary}",
        "width": "{border-width.100}",
        "style": "{border-style.solid}"
      }
    },
    "strong": {
      "$description": "border-strong — emphasis outlines",
      "$value": {
        "color": "{color.border.primary}",
        "width": "{border-width.200}",
        "style": "{border-style.solid}"
      }
    }
  }
}
