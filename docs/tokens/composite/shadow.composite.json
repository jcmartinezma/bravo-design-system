{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "shadow": {
    "$description": "Composite elevation shadows. Starter examples only.",
    "$type": "shadow",
    "sm": {
      "$description": "shadow-sm — subtle elevation (cards, menus)",
      "$value": {
        "color": "{color.alpha.100}",
        "offsetX": "{shadow.offset.0}",
        "offsetY": "{shadow.offset.100}",
        "blur": "{shadow.blur.100}",
        "spread": "{shadow.spread.0}"
      }
    },
    "md": {
      "$description": "shadow-md — medium elevation (modals, popovers)",
      "$value": {
        "color": "{color.alpha.200}",
        "offsetX": "{shadow.offset.0}",
        "offsetY": "{shadow.offset.200}",
        "blur": "{shadow.blur.200}",
        "spread": "{shadow.spread.0}"
      }
    },
    "lg": {
      "$description": "shadow-lg — strong elevation (dialogs, overlays)",
      "$value": {
        "color": "{color.alpha.300}",
        "offsetX": "{shadow.offset.0}",
        "offsetY": "{shadow.offset.300}",
        "blur": "{shadow.blur.300}",
        "spread": "{shadow.spread.0}"
      }
    }
  }
}
