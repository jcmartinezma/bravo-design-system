{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "motion": {
    "$description": "Semantic motion roles referencing core duration, delay, and easing",
    "speed": {
      "$description": "How long a transition runs",
      "fast": {
        "$type": "duration",
        "$value": "{duration.100}",
        "$description": "motion-speed-fast — micro-interactions and quick feedback"
      },
      "normal": {
        "$type": "duration",
        "$value": "{duration.200}",
        "$description": "motion-speed-normal — standard UI transitions"
      },
      "slow": {
        "$type": "duration",
        "$value": "{duration.300}",
        "$description": "motion-speed-slow — larger moves (panels, page emphasis)"
      }
    },
    "delay": {
      "$description": "Wait before a transition starts",
      "$type": "duration",
      "none": {
        "$value": "{delay.0}",
        "$description": "motion-delay-none — start immediately"
      },
      "short": {
        "$value": "{delay.100}",
        "$description": "motion-delay-short — brief stagger between sequenced motions"
      }
    },
    "easing": {
      "$description": "Semantic easing roles referencing core cubic-bezier curves",
      "$type": "cubicBezier",
      "in": {
        "$value": "{easing.100}",
        "$description": "motion-easing-in — starts slow, speeds up (exits, dismissals)"
      },
      "out": {
        "$value": "{easing.200}",
        "$description": "motion-easing-out — starts fast, slows down (entrances, settles)"
      },
      "in-out": {
        "$value": "{easing.300}",
        "$description": "motion-easing-in-out — smooth at both ends (default UI transitions)"
      }
    }
  }
}
