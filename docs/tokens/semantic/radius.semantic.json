{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "radius": {
    "$description": "Semantic radius roles referencing core radius values",
    "$type": "dimension",
    "sm": {
      "$value": "{radius.100}",
      "$description": "Small radius"
    },
    "md": {
      "$value": "{radius.200}",
      "$description": "Medium radius"
    },
    "lg": {
      "$value": "{radius.300}",
      "$description": "Large radius"
    },
    "xl": {
      "$value": "{radius.400}",
      "$description": "Extra large radius"
    },
    "full": {
      "$value": "{radius.500}",
      "$description": "Full / pill radius"
    }
  }
}
