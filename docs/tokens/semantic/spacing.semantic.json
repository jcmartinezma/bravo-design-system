{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "spacing": {
    "$type": "dimension",
    "$description": "Semantic spacing roles referencing the core scale (Applicable for heights, widths, paddings, margins, gaps, etc.)",
    "xs": {
      "$value": "{spacing.100}",
      "$description": "spacing-xs — tight gaps (icons next to labels)"
    },
    "sm": {
      "$value": "{spacing.200}",
      "$description": "spacing-sm — compact padding and small stacks"
    },
    "md": {
      "$value": "{spacing.300}",
      "$description": "spacing-md — default gap between related items"
    },
    "lg": {
      "$value": "{spacing.400}",
      "$description": "spacing-lg — section padding and larger stacks"
    },
    "xl": {
      "$value": "{spacing.500}",
      "$description": "spacing-xl — generous layout breathing room"
    },
    "2xl": {
      "$value": "{spacing.600}",
      "$description": "spacing-2xl — page-level separation"
    },
    "3xl": {
      "$value": "{spacing.700}",
      "$description": "spacing-3xl — page-level separation"
    },
    "4xl": {
      "$value": "{spacing.800}",
      "$description": "spacing-4xl — page-level separation"
    },
    "5xl": {
      "$value": "{spacing.900}",
      "$description": "spacing-5xl — page-level separation"
    },
    "6xl": {
      "$value": "{spacing.1000}",
      "$description": "spacing-6xl — page-level separation"
    },
    "7xl": {
      "$value": "{spacing.1100}",
      "$description": "spacing-7xl — page-level separation"
    },
    "8xl": {
      "$value": "{spacing.1200}",
      "$description": "spacing-8xl — page-level separation"
    },
    "9xl": {
      "$value": "{spacing.1300}",
      "$description": "spacing-9xl — page-level separation"
    },
    "10xl": {
      "$value": "{spacing.1400}",
      "$description": "spacing-10xl — page-level separation"
    },
    "11xl": {
      "$value": "{spacing.1500}",
      "$description": "spacing-11xl — page-level separation"
    },
    "12xl": {
      "$value": "{spacing.1600}",
      "$description": "spacing-12xl — page-level separation"
    },
    "13xl": {
      "$value": "{spacing.1700}",
      "$description": "spacing-13xl — page-level separation"
    },
    "14xl": {
      "$value": "{spacing.1800}",
      "$description": "spacing-14xl — page-level separation"
    },
    "15xl": {
      "$value": "{spacing.1900}",
      "$description": "spacing-15xl — page-level separation"
    },
    "16xl": {
