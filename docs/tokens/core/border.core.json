{
  "$schema": "https://www.designtokens.org/tr/2025.10/format/",
  "border-width": {
    "$description": "Core border widths",
    "$type": "dimension",
    "100": {
      "$value": { "value": 1, "unit": "px" },
      "$description": "Value of 1px"
    },
    "200": {
      "$value": { "value": 2, "unit": "px" },
      "$description": "Value of 2px"
    }
  },
  "border-style": {
    "$description": "Core border stroke styles",
    "$type": "strokeStyle",
    "solid": {
      "$value": "solid",
      "$description": "Solid continuous line"
    },
    "dashed": {
      "$value": "dashed",
      "$description": "Dashed line — optional or temporary boundaries"
    }
  }
}
