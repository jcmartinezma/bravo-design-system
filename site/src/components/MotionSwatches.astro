---
/**
 * Motion token previews: durations, delays, speeds, easings, and composite transitions.
 *
 * Data: site/src/data/motion-previews.json (tokens:build).
 * In MDX: <MotionSwatches />
 */
import data from '../data/motion-previews.json';

interface Preview {
	tokenName: string;
	cssName: string;
	displayValue: string;
	description?: string;
}

const duration = data.duration as Preview[];
const delay = (data.delay ?? []) as Preview[];
const speed = data.speed as Preview[];
const easing = data.easing as Preview[];
const transition = data.transition as Preview[];
---

<section class="motion-previews" aria-label="Motion tokens">
	{
		duration.length > 0 && (
			<div class="motion-previews__group">
				<h3>Duration (core)</h3>
				<ul class="motion-previews__list">
					{duration.map((item) => (
						<li class="motion-previews__item">
							<div
								class="motion-previews__pulse"
								style={`animation-duration: var(${item.cssName})`}
								aria-hidden="true"
							/>
							<div class="motion-previews__meta">
								<code class="motion-previews__name">{item.tokenName}</code>
								<span class="motion-previews__value">{item.displayValue}</span>
							</div>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		delay.length > 0 && (
			<div class="motion-previews__group">
				<h3>Delay (core)</h3>
				<ul class="motion-previews__list">
					{delay.map((item) => (
						<li class="motion-previews__item">
							<div class="motion-previews__meta">
								<code class="motion-previews__name">{item.tokenName}</code>
								<span class="motion-previews__value">{item.displayValue}</span>
								{item.description ? (
									<p class="motion-previews__desc">{item.description}</p>
								) : null}
							</div>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		speed.length > 0 && (
			<div class="motion-previews__group">
				<h3>Speed (semantic)</h3>
				<ul class="motion-previews__list">
					{speed.map((item) => (
						<li class="motion-previews__item">
							<div
								class="motion-previews__pulse"
								style={`animation-duration: var(${item.cssName})`}
								aria-hidden="true"
							/>
							<div class="motion-previews__meta">
								<code class="motion-previews__name">{item.tokenName}</code>
								<span class="motion-previews__value">{item.displayValue}</span>
							</div>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		easing.length > 0 && (
			<div class="motion-previews__group">
				<h3>Easing (semantic)</h3>
				<ul class="motion-previews__list">
					{easing.map((item) => (
						<li class="motion-previews__item">
							<div
								class="motion-previews__ease"
								style={`--motion-preview-ease: var(${item.cssName})`}
								aria-hidden="true"
							>
								<span class="motion-previews__ease-dot" />
							</div>
							<div class="motion-previews__meta">
								<code class="motion-previews__name">{item.tokenName}</code>
								<span class="motion-previews__value">{item.displayValue}</span>
							</div>
						</li>
					))}
				</ul>
			</div>
		)
	}

	{
		transition.length > 0 && (
			<div class="motion-previews__group">
				<h3>Transitions (composite)</h3>
				<ul class="motion-previews__list">
					{transition.map((item) => (
						<li class="motion-previews__item">
							<button
								type="button"
								class="motion-previews__demo"
								style={`transition: background-color var(${item.cssName}), transform var(${item.cssName})`}
							>
								Hover me
							</button>
							<div class="motion-previews__meta">
								<code class="motion-previews__name">{item.tokenName}</code>
								<span class="motion-previews__value">{item.displayValue}</span>
								{item.description ? (
									<p class="motion-previews__desc">{item.description}</p>
								) : null}
							</div>
						</li>
					))}
				</ul>
			</div>
		)
	}
</section>
