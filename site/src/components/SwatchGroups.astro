---
/**
 * Shared markup for colorCore / colorSemantic.
 * Styles: src/styles/components.scss (.swatches, .swatch, …).
 *
 * Semantic swatches may include displayValueDark; CSS toggles light/dark labels
 * with [data-theme="dark"] (same switch as the docs site theme).
 */
interface Swatch {
	tokenName: string;
	cssName: string;
	displayValue: string;
	displayValueDark?: string;
}

interface Group {
	name: string;
	swatches: Swatch[];
}

interface Props {
	/** Visible heading for the whole block (and aria-label). */
	label: string;
	groups: Group[];
}

const { label, groups } = Astro.props;
---

<section class="swatches" aria-label={label}>
	{
		groups.map((group) => (
			<div class="swatch-group">
				<h3>{group.name}</h3>
				<ul class="swatch-grid">
					{group.swatches.map((swatch) => (
						<li class="swatch">
							<span
								class:list={[
									'swatch__chip',
									swatch.displayValue === 'transparent' && 'swatch__chip--transparent',
								]}
								style={`background-color: var(${swatch.cssName})`}
								aria-hidden="true"
							/>
							<code class="swatch__name">{swatch.tokenName}</code>
							{swatch.displayValueDark != null ? (
								<>
									<span class="swatch__value swatch__value--light">{swatch.displayValue}</span>
									<span class="swatch__value swatch__value--dark">{swatch.displayValueDark}</span>
								</>
							) : (
								<span class="swatch__value">{swatch.displayValue}</span>
							)}
						</li>
					))}
				</ul>
			</div>
		))
	}
</section>
