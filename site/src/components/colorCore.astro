---
/**
 * Primitive (core) color palette swatches.
 *
 * Data: site/src/data/color-swatches.json (written by tokens:build).
 * Chips use CSS variables from styles/generated/tokens.css — edit docs/tokens JSON, then
 * tokens rebuild (automatic in `astro dev`) and refresh to see updates.
 *
 * In a docs MDX file (no import needed — mapped in [...slug].astro):
 *   <ColorCore />
 */
import swatches from '../data/color-swatches.json';
import SwatchGroups from './SwatchGroups.astro';
---

<SwatchGroups label="Core color palette" groups={swatches.core} />
