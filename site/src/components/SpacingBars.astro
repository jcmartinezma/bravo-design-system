---
/**
 * Shared list for spacing scale bars (SpacingCore / SpacingSemantic).
 * Styles: src/styles/components.scss (.token-bars, …).
 */
interface Preview {
	tokenName: string;
	cssName: string;
	displayValue: string;
}

interface Props {
	label: string;
	items: Preview[];
}

const { label, items } = Astro.props;
---

<section class="token-bars" aria-label={label}>
	<ul class="token-bars__list">
		{
			items.map((item) => (
				<li class="token-bars__item">
					<span
						class="token-bars__bar"
						style={`width: var(${item.cssName})`}
						aria-hidden="true"
					/>
					<div class="token-bars__meta">
						<code class="token-bars__name">{item.tokenName}</code>
						<span class="token-bars__value">{item.displayValue}</span>
					</div>
				</li>
			))
		}
	</ul>
</section>
