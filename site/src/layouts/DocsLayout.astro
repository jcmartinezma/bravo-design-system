---
import Layout from './Layout.astro';

interface Props {
	title: string;
	description?: string;
	currentPath?: string;
	status?: string;
	owner?: string;
	update?: string;
}

const {
	title,
	description,
	currentPath = Astro.url.pathname,
	status,
	owner,
	update,
} = Astro.props;

const hasMeta = Boolean(status || owner || update);
---

<Layout title={title} description={description} currentPath={currentPath}>
	{
		hasMeta && (
			<header class="doc-meta" aria-label="Document metadata">
				{status && (
					<span class="doc-meta__pill">
						<span class="doc-meta__label">Status</span>
						<span class="doc-meta__value">{status}</span>
					</span>
				)}
				{owner && (
					<span class="doc-meta__pill">
						<span class="doc-meta__label">Owner</span>
						<span class="doc-meta__value">{owner}</span>
					</span>
				)}
				{update && (
					<span class="doc-meta__pill">
						<span class="doc-meta__label">Updated</span>
						<span class="doc-meta__value">{update}</span>
					</span>
				)}
			</header>
		)
	}
	<slot />
</Layout>
